<app-host> {
	import lab_common
	encode zstd gzip

	# F3 (CLAUDE.md §16): the party WebSocket runs on a dedicated server on port 3002.
	# Route /api/party/ws* there; everything else goes to the Next.js app on 3001.
	# Caddy upgrades WebSockets automatically (forwards Upgrade/Connection). The
	# handle blocks are evaluated in order, so the WS path is matched before the
	# catch-all and cannot be swallowed by it.
	handle /api/party/ws* {
		reverse_proxy unified-frontend:3002
	}
	handle {
		reverse_proxy unified-frontend:3001
	}
}
